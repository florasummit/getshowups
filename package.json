{
  "name": "getshowups",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test 'test/*.test.js'",
    "test:e2e": "playwright test",
    "check:functions": "wrangler pages functions build ./functions --outdir .wrangler/functions-check --compatibility-date 2026-11-08",
    "verify": "oxlint --deny-warnings && npm test && npm run build && npm run check:functions",
    "verify:all": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
