E2E_SALES_OWNER_EMAIL=owner@e2e-sales.example
E2E_SALES_OWNER_SESSION_TOKEN=e2eSessionTokenForTheAssistedOwnerClaims100
E2E_SALES_OWNER2_EMAIL=owner2@e2e-sales.example
