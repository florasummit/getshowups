E2E_TEXTS_LEAD_PHONE=+15550100777
E2E_TWILIO_AUTH_TOKEN=e2e-fake-twilio-auth-token
# Visual tour (tour.spec.js): a fictional business with representative history (seed-tour.mjs). Read-only use.
E2E_TOUR_CUSTOMER=e2e-tour
E2E_TOUR_SESSION_TOKEN=e2eSessionTokenForTheVisualTourBusines00014
# Website Studio full journey (website-flow.spec.js): a fresh business per browser project, no website yet.
E2E_FLOW_CUSTOMER=e2e-flow
E2E_FLOW_SESSION_TOKEN=e2eSessionTokenForTheWebsiteFlowDeskto00015
E2E_FLOW_M_CUSTOMER=e2e-flow-m
E2E_FLOW_M_SESSION_TOKEN=e2eSessionTokenForTheWebsiteFlowMobile00016
# Publish/restore (website.spec.js): its own business with an already-published site, so it never races the
# edit-and-publish test that runs in parallel on E2E_CUSTOMER.
E2E_PUBLISH_CUSTOMER=e2e-publish
E2E_PUBLISH_SESSION_TOKEN=e2eSessionTokenForThePublishRestoreDes00017
# Website Studio hardening (studio-hardening.spec.js, Agent A): one business per browser project, seeded like the
# editor businesses (test/e2e/editor-draft.json), so these runs never touch another spec's website.
E2E_STUDIO_H_CUSTOMER=e2e-studio-h
E2E_STUDIO_H_SESSION_TOKEN=e2eSessionTokenForTheStudioHardeningDes0018
E2E_STUDIO_H_M_CUSTOMER=e2e-studio-h-m
E2E_STUDIO_H_M_SESSION_TOKEN=e2eSessionTokenForTheStudioHardeningMob0019
# Control Center demo (control-center.spec.js): its own TEST business (bookable, calendar record) + a fake cron secret.
E2E_CC_CUSTOMER=e2e-cc
E2E_CRON_SECRET=e2e-cron-secret-not-a-secret-0123456789abcdef
E2E_QA_INGEST_TOKEN=e2e-qa-ingest-token-not-a-secret-0123456789
# Website import + own-key test (import.spec.js): its own business, so ads.spec.js suspending e2e-ads can't collide.
E2E_IMPORT_CUSTOMER=e2e-import
E2E_IMPORT_SESSION_TOKEN=e2eSessionTokenForTheWebsiteImportBusin0020
# ChatGPT Ads (ads-openai.spec.js): its own business, NOT test-marked (a test business may never create in a real
# ChatGPT Ads account), listed in OPENAI_ADS_VERIFY_BUSINESSES; OpenAI is the stand-in in mock-google.mjs.
E2E_OPENAI_CUSTOMER=e2e-openai
E2E_OPENAI_SESSION_TOKEN=e2eSessionTokenForTheChatGptAdsBusiness0021
E2E_OPENAI_ADS_KEY=e2e-openai-ads-key-not-a-secret-0123456789
# Teach Your AI (teach-ai.spec.js): a pool business per browser project (visits the customer, two towns, ZIP list),
# both in AI_STUDIO_BUSINESSES; AI_RULES_LIVE_BUSINESSES stays unset (published rules never reach conversations).
E2E_TEACH_CUSTOMER=e2e-teach
E2E_TEACH_SESSION_TOKEN=e2eSessionTokenForTheTeachYourAiDeskto00018
E2E_TEACH_M_CUSTOMER=e2e-teach-m
E2E_TEACH_M_SESSION_TOKEN=e2eSessionTokenForTheTeachYourAiMobile00019
# Autonomous customer journey (journey.spec.js): fresh self-serve signups per browser project. These addresses are
# listed as test recipients in serve.sh (sandbox checkout allowed), exactly like a real activation tester.
E2E_JOURNEY_EMAIL=journey@e2e-journey.example
E2E_JOURNEY_M_EMAIL=journey-m@e2e-journey.example
# Receptionist voice (receptionist-voice.spec.js): a business per browser project with Retell configured against the
# mock (voice catalog + web calls faked); a SECOND platform admin who is a member of both (the first admin has no
# business on purpose, admin.spec.js relies on that).
E2E_VOICE_CUSTOMER=e2e-voice
E2E_VOICE_SESSION_TOKEN=e2eSessionTokenForTheVoiceDesktopBusine0021
E2E_VOICE_M_CUSTOMER=e2e-voice-m
E2E_VOICE_M_SESSION_TOKEN=e2eSessionTokenForTheVoiceMobileBusines0022
E2E_VOICE_ADMIN_EMAIL=voiceadmin@getshowups.example
E2E_VOICE_ADMIN_SESSION_TOKEN=e2eSessionTokenForTheVoiceAdminMemberOf0023
# Admin Console voice-provider management (voice-rollout.spec.js): an admin-marked TEST business on OpenAI (not
# configured in e2e) with a finished admin test session on Retell, so the first platform admin (member of nothing) can
# run Review → Activate (typed id) → Rollback from /admin/voice-lab.
E2E_VOICE_SWITCH_CUSTOMER=e2e-voice-switch
# Business details (business-details.spec.js): its own bookable business (customers come to it, Mon–Fri 9–5) whose
# per-day booking hours the spec saves, with an address the owner shows to customers. No other spec reads or edits it.
E2E_DETAILS_CUSTOMER=e2e-details
E2E_DETAILS_SESSION_TOKEN=e2eSessionTokenForTheBusinessDetailsBus0024
# Email sign-in (email-signin.spec.js): its own business and addresses, so no other spec's sign-in or rate limit collides.
# OWNER is a member (also signs in with Google: same address = same person); NEW and LINK have no business (testers);
# PHONE(_M) one per browser project; STRANGER may not sign in (not a member, invitee, tester or admin): no email, same answer.
# EXPIRED_LINK: the token of a seeded, already expired sign-in link (43 characters; only its SHA-256 is stored).
E2E_EMAILAUTH_CUSTOMER=e2e-emailauth
E2E_EMAILAUTH_OWNER=owner@e2e-emailauth.example
E2E_EMAILAUTH_NEW=new@e2e-emailauth.example
E2E_EMAILAUTH_LINK=link@e2e-emailauth.example
E2E_EMAILAUTH_PHONE=phone@e2e-emailauth.example
E2E_EMAILAUTH_PHONE_M=phone-m@e2e-emailauth.example
E2E_EMAILAUTH_STRANGER=stranger@e2e-emailauth.example
E2E_EMAILAUTH_EXPIRED_LINK=e2eExpiredEmailSignInLinkTokenForTheSpec046
# Assisted enrollment (enrollment.spec.js): sales staff (roles seeded in serve.sh), owners without a business who claim
