# GetShowUps — public frontend configuration.
# Copy to .env.local for local dev, and set the same variables in
# Cloudflare Pages → Settings → Environment variables for production.
#
# EVERY VITE_* VALUE IS BUNDLED INTO PUBLIC JAVASCRIPT.
# Only put values here that are safe for anyone to see (public embed URLs).
# Never put GHL API keys, private integration tokens, or webhook secrets here.

# Booking calendar URL, embedded in the "Book a Demo" section.
# Google Calendar now (Appointment schedule → Share → Website embed → copy the iframe src):
#   https://calendar.google.com/calendar/appointments/schedules/XXXXXXXX?gv=true
# GHL later (Calendars → Share → embed src) — just replace the value:
#   https://api.leadconnectorhq.com/widget/booking/XXXXXXXXXXXX
VITE_GHL_BOOKING_URL=

# Optional: GHL form/survey embed URL, used as a fallback "Request a demo" form
# when no booking calendar is configured.
# e.g. https://api.leadconnectorhq.com/widget/form/XXXXXXXXXXXX
VITE_GHL_FORM_URL=

# Optional: public contact email shown when neither embed is configured.
VITE_CONTACT_EMAIL=
